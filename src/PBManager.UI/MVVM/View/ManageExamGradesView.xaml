<Window x:Class="PBManager.UI.MVVM.View.ManageExamGradesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{Binding ExamTitle}"
        Height="520" Width="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        MinHeight="500"
        MinWidth="900">
    <Border Background="{StaticResource BgPrimaryBrush}" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Background="Transparent"
                  Height="50">
                <TextBlock Text="{Binding ExamTitle}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="White"
                          FontSize="20"/>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,5,5,0">
                    <Button x:Name="MinimizeButton" 
                           Click="MinimizeButton_Click" 
                           Content="—" 
                           Style="{StaticResource WindowButtonStyle}"/>
                    <Button x:Name="MaximizeButton" 
                           Click="MaximizeButton_Click" 
                           Content="☐" 
                           Style="{StaticResource WindowButtonStyle}"/>
                    <Button x:Name="CloseButton" 
                           Click="CloseButton_Click" 
                           Content="✕" 
                           Style="{StaticResource WindowButtonStyle}"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1"
                        ItemsSource="{Binding ClassTabs}"
                        SelectedItem="{Binding SelectedTab}"
                        Margin="10"
                        Style="{StaticResource ModernTabControlStyle}"
                        ItemContainerStyle="{StaticResource ModernTabItemStyle}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TabHeader}"
                                  Foreground="White"
                                  FontSize="14"
                                  Margin="20,5"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="1" 
                                       Background="{StaticResource TableHeaderBrush}" 
                                       CornerRadius="8,8,0,0" 
                                       Padding="5"
                                       Margin="0,5,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="نام" 
                                                  Grid.Column="0" 
                                                  Foreground="White" 
                                                  FontWeight="Bold" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Text="کد ملی" 
                                                  Grid.Column="1" 
                                                  Foreground="White" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>

                                        <ItemsControl Grid.Column="2" 
                                                      ItemsSource="{Binding Exam.Subjects}"
                                                      FlowDirection="RightToLeft">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" 
                                                              Foreground="White" 
                                                              FontWeight="Bold"
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"
                                                              TextWrapping="Wrap"
                                                              Margin="5,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" 
                                       Background="{StaticResource TableBgBrush}" 
                                       CornerRadius="0,0,8,8" 
                                       Padding="5">
                                    <ItemsControl ItemsSource="{Binding StudentRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2" 
                                                        Padding="5" 
                                                        CornerRadius="5"
                                                        Background="{StaticResource BorderBrush}"
                                                        Focusable="False">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" 
                                                                  Text="{Binding StudentName}" 
                                                                  Foreground="White" 
                                                                  VerticalAlignment="Center" 
                                                                  HorizontalAlignment="Center"
                                                                  FontWeight="Bold"/>

                                                        <TextBlock Grid.Column="1" 
                                                                  Text="{Binding NationalCode}" 
                                                                  Foreground="White" 
                                                                  VerticalAlignment="Center" 
                                                                  HorizontalAlignment="Center"/>

                                                        <ItemsControl Grid.Column="2" 
                                                                     ItemsSource="{Binding SubjectGrades}">
                                                            <ItemsControl.ItemsPanel >
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="5" 
                                                                            Background="{StaticResource TableHeaderBrush}" 
                                                                            Width="70" 
                                                                            Height="30" 
                                                                            BorderThickness="1"
                                                                            HorizontalAlignment="Center"
                                                                            Margin="2"
                                                                            Focusable="False">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Score.Length}" Value="0">
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                                        <Setter Property="BorderBrush" Value="Crimson"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBox Text="{Binding Score, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                                Style="{StaticResource StudyInputTextBox}" 
                                                                                BorderThickness="0" 
                                                                                Validation.ErrorTemplate="{x:Null}"
                                                                                BorderBrush="Transparent" 
                                                                                Background="Transparent" 
                                                                                HorizontalContentAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Button Grid.Row="2"
                   Background="{StaticResource SubmitGreenBrush}"
                   Command="{Binding SaveAllGradesCommand}"
                   Content="ذخیره همه نمرات"
                   Width="150"
                   Height="35"
                   Margin="10"
                   Style="{StaticResource ModernButtonStyle}"/>
        </Grid>
    </Border>
</Window>